{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{css,js,vue}\" eslint.config.js vite.config.js package.json",
        "format:check": "prettier --check \"resources/**/*.{css,js,vue}\" eslint.config.js vite.config.js package.json",
        "lint": "eslint .",
        "demo:smoke": "./scripts/smoke-demo.zsh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^3.11.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.4",
        "@vitejs/plugin-vue": "^6.0.10",
        "alpinejs": "^3.17.5",
        "axios": "^1.21.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.6",
        "vue": "^3.5.45"
    },
    "dependencies": {
        "lodash": "^4.18.1"
    },
    "prettier": {
        "plugins": [
            "prettier-plugin-tailwindcss"
        ],
        "tailwindStylesheet": "./resources/css/app.css",
        "printWidth": 120,
        "singleQuote": true,
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.css",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
